# Copy to .env and adjust. .env is gitignored; only this example is committed.
# Every value here is invented. Change the passwords and token before any shared use.

# Compose project name and host ports. Change all four to run a second stack
# beside this one (e.g. s0t5 / 5435 / 3052 / 3051 for a parallel worktree).
COMPOSE_PROJECT_NAME=s0main
POSTGRES_PORT=5432
UPSTREAM_PORT=3002
MIDDLEWARE_PORT=3001

# Postgres superuser (container init only) and the three application roles.
POSTGRES_PASSWORD=postgres_password_change_me
SANDBOX_APP_PASSWORD=sandbox_app_password_change_me
TRIAGE_APP_PASSWORD=triage_app_password_change_me
TRIAGE_RO_PASSWORD=triage_ro_password_change_me

# DATABASE_URL per role, as seen from the host (the containers build their own
# from the passwords above and the service name `postgres`).
SANDBOX_APP_DATABASE_URL=postgresql://sandbox_app:sandbox_app_password_change_me@localhost:5432/sandbox
TRIAGE_APP_DATABASE_URL=postgresql://triage_app:triage_app_password_change_me@localhost:5432/triage
TRIAGE_RO_DATABASE_URL=postgresql://triage_ro:triage_ro_password_change_me@localhost:5432/sandbox

# Sandbox Middleware -> Sandbox Upstream (the Partner).
PARTNER_BASE_URL=http://upstream:3002
PARTNER_TOKEN=sandbox-token-change-me
PARTNER_TIMEOUT_MS=3000

# Sandbox Upstream: initial Fault (none | schema_drift | rate_limit_429 | auth_expired | upstream_timeout).
PARTNER_FAULT=none

# Where the test suite and the Caller script find the stack, from the host.
MIDDLEWARE_URL=http://localhost:3001
UPSTREAM_URL=http://localhost:3002
