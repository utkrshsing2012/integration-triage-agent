# Copy to .env and adjust. .env is gitignored; only this example is committed.
# Every value here is invented. Change the passwords and token before any shared use.
# The defaults below are also the Compose file's own defaults, so the stack runs with no env file.

# Compose project name and host ports. Change all four to run a second stack
# beside this one (e.g. s0t5 / 5435 / 3052 / 3051 for a parallel worktree).
# Compose project name: prefixes container and volume names, keeps parallel stacks apart.
COMPOSE_PROJECT_NAME=s0main
# Host port mapped to Postgres (container port stays 5432).
POSTGRES_PORT=5432
# Host port mapped to the Sandbox Upstream (container port stays 3002).
UPSTREAM_PORT=3002
# Host port mapped to the Sandbox Middleware (container port stays 3001).
MIDDLEWARE_PORT=3001

# Postgres superuser (container init only) and the three application roles.
# Password of the postgres superuser; used only by the container's first-boot init.
POSTGRES_PASSWORD=postgres_password_change_me
# Password of sandbox_app, owner of database `sandbox`; the Sandbox Middleware migrates and writes as this role.
SANDBOX_APP_PASSWORD=sandbox_app_password_change_me
# Password of triage_app, owner of database `triage`; the Triage Service connects as this role from step 1.
TRIAGE_APP_PASSWORD=triage_app_password_change_me
# Password of triage_ro, SELECT-only on `sandbox`; the outer-edge suite and the demo query use it.
TRIAGE_RO_PASSWORD=triage_ro_password_change_me

# DATABASE_URL per role, as seen from the host (the containers build their own
# from the passwords above and the service name `postgres`; the middleware's
# Prisma reads that one as DATABASE_URL).
# sandbox_app from the host, e.g. for `npx prisma` against the running stack.
SANDBOX_APP_DATABASE_URL=postgresql://sandbox_app:sandbox_app_password_change_me@localhost:5432/sandbox
# triage_app from the host; nothing reads it until the Triage Service arrives in step 1.
TRIAGE_APP_DATABASE_URL=postgresql://triage_app:triage_app_password_change_me@localhost:5432/triage
# triage_ro from the host; what the test suite connects with (packages/sandbox-tests/src/env.ts).
TRIAGE_RO_DATABASE_URL=postgresql://triage_ro:triage_ro_password_change_me@localhost:5432/sandbox

# Sandbox Middleware -> Sandbox Upstream (the Partner).
# Where the Sandbox Middleware reaches the Sandbox Upstream; inside the Compose network it is the service name.
PARTNER_BASE_URL=http://upstream:3002
# Static bearer token the middleware sends and the upstream checks; never refreshed, by design.
PARTNER_TOKEN=sandbox-token-change-me
# Fixed client timeout for every outbound call, in ms; the upstream_timeout Fingerprint's duration_ms is pinned here.
PARTNER_TIMEOUT_MS=3000

# Sandbox Upstream: initial Fault (none | schema_drift | rate_limit_429 | auth_expired | upstream_timeout).
# Fault the upstream boots with; POST /__admin/fault changes it at runtime, a container restart resets to this.
PARTNER_FAULT=none

# Where the test suite and the Caller script find the stack, from the host.
# Sandbox Middleware base URL for the suite and the Caller (defaults to the MIDDLEWARE_PORT above).
MIDDLEWARE_URL=http://localhost:3001
# Sandbox Upstream base URL for the suite and the Caller, including the admin switch (defaults to UPSTREAM_PORT above).
UPSTREAM_URL=http://localhost:3002
